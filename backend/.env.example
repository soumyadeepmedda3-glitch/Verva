PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Verva

# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# Secret used to sign login tokens (JWT). Use a long, random string in
# production — e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Email (used for the "forgot password" feature). If SMTP_HOST is left
# blank, reset codes are printed to the backend console instead of being
# emailed — handy for local development without setting up real SMTP.
# For Gmail: host=smtp.gmail.com, port=587, use an "App Password" (not
# your normal password) as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@verva.app
APP_NAME=Verva

# Azure Speech (Neural TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
